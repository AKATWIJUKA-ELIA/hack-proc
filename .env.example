# Copy to .env.local and fill in. Never commit .env.local.
#
# The Convex deployment the Next.js browser client talks to. Use the
# .convex.cloud host (queries/mutations over websocket), not .convex.site
# (which only serves HTTP actions such as the AgentMail webhook).
#
# Dev:  https://veracious-stork-385.convex.cloud
# Prod: https://admired-partridge-220.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Set by `npx convex dev` — identifies which deployment the CLI pushes to.
CONVEX_DEPLOYMENT=
